---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { products, store } from '../data/catalog';
---
<Base>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="little-line"></span> A SPLENDOR OF FLAVOR</p><h1>Rasa istimewa,<br />untuk setiap<br /><em>momen.</em></h1><p class="hero-description">Dari jeda kecil di tengah hari, hingga perayaan bersama orang tersayang. Temukan sesuatu yang istimewa di Luke.</p><a class="button" href="/katalog/">Jelajahi Katalog <Icon name="arrow" /></a><div class="hero-footnote"><span class="star">✳</span><span>Artisan bakery & gourmet eatery<br /><strong>di jantung kota Malang.</strong></span></div></div>
    <div class="hero-visual"><div class="hero-image"><img src="/images/tiramisu.jpg" alt="Tiramisu whole cake Luke berbalut pita, dengan lilin untuk momen perayaan" width="640" height="800" fetchpriority="high" /></div><div class="image-caption"><span>THE LUKE COLLECTION</span><span>A little taste of celebration.</span></div><div class="hero-seal"><span>LUKE</span><span>with love,<br />from Malang</span></div></div>
  </section>
  <div class="brand-strip"><span>TIRAMISU & CAKES</span><span>✳</span><span>BREAD & PASTRIES</span><span>✳</span><span>CELEBRATIONS</span><span>✳</span><span>THOUGHTFUL GIFTS</span></div>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">A LITTLE SOMETHING FOR YOU</p><h2>Temukan pilihan <em>Anda.</em></h2></div><a class="text-link" href="/katalog/">Lihat seluruh katalog <Icon name="arrow" /></a></div><div class="product-grid">{products.filter(p => p.featured).map((product, index) => <ProductCard product={product} index={index} />)}</div><div class="collection-links" aria-label="Jelajahi koleksi"><a href="/katalog/?kategori=cakes">Tiramisu & Cakes ↗</a><a href="/katalog/?kategori=pastries">Viennoiserie ↗</a><a href="/katalog/?kategori=bread">Bread ↗</a><a href="/katalog/?kategori=gifts">Hampers & Gifts ↗</a></div></section>
  <section class="editorial"><div class="wrap editorial-grid"><div class="editorial-photo"><img src="/images/celebration.jpg" alt="Cake dengan dekorasi bunga dari publikasi Luke" width="640" height="335" loading="lazy" /></div><div class="editorial-copy"><p class="eyebrow">FOR THE OCCASIONS THAT MATTER</p><h2>Sebuah perayaan.<br />Sebuah <em>kenangan.</em></h2><p>Ulang tahun, kabar bahagia, atau sekadar ingin berbagi. Bicarakan cake untuk momen Anda bersama tim Luke.</p><a href="/produk/celebration-cakes/" class="text-link">Temukan celebration cakes <Icon name="arrow" /></a></div></div></section>
  <section class="section wrap how-section"><div class="section-heading"><div><p class="eyebrow">FROM OUR BAKERY, TO YOUR MOMENT</p><h2>Pilih. Ceritakan. <em>Nikmati.</em></h2></div><p class="section-aside">Pilihan Anda, disiapkan untuk<br />diambil langsung di bakery.</p></div><div class="steps"><div><span>01</span><h3>Temukan favorit Anda</h3><p>Jelajahi katalog dan simpan produk yang ingin Anda pesan.</p></div><div><span>02</span><h3>Lanjutkan percakapan</h3><p>Sampaikan pilihan dan preferensi waktu pengambilan melalui WhatsApp.</p></div><div><span>03</span><h3>Ambil di Luke</h3><p>Tim kami mengonfirmasi ketersediaan, total akhir, dan waktu pengambilan.</p></div></div></section>
  <section class="wrap brand-story"><p class="eyebrow">A CLASSIC BAKERY & GOURMET EATERY BY CENGLI GROUP</p><h2>Sebuah jeda kecil.<br /><em>Rasa yang tinggal lebih lama.</em></h2><p>{store.tagline}. Luke Artisan Bakery hadir di Pahlawan Trip, Malang, dengan pilihan bakery, cake, dan gourmet eatery dari {store.group}. Datang untuk menikmati waktu Anda, atau bawa pulang sesuatu untuk dibagikan.</p><a href={store.instagram} class="text-link" target="_blank" rel="noopener noreferrer">Cerita terbaru dari Luke di Instagram ↗</a></section>
  <section class="visit-band wrap"><div><p class="eyebrow">WE'D LOVE TO SEE YOU</p><h2>Mampir ke <em>Luke.</em></h2><p>{store.address}</p></div><div class="hours"><p>Bakery <span>07.00 – 22.00</span></p><p>Eatery <span>07.00 – 20.00</span></p><span>Senin – Minggu · WIB</span></div><a class="button button-light" href="/kunjungi/">Rencanakan kunjungan <Icon name="arrow" /></a></section>
</Base>
