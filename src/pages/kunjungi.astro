---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { store } from '../data/catalog';
---
<Base title="Kunjungi Kami — Luke Artisan Bakery">
  <section class="page-intro wrap"><p class="eyebrow">IN THE HEART OF MALANG</p><h1>Sampai jumpa <em>di Luke.</em></h1><p>Sebuah jeda, percakapan hangat, dan sesuatu yang istimewa untuk dinikmati.</p></section>
  <section class="wrap visit-page"><div class="location-art"><img src="/images/luke-monogram.jpg" alt="Monogram Luke Artisan Bakery" width="150" height="150" /><span>7°58′ S · 112°37′ E</span><h2>Malang,<br /><em>with love.</em></h2><span>PAHLAWAN TRIP NO. 11</span></div><div class="visit-details"><p class="eyebrow">OUR BAKERY</p><h2>Pahlawan Trip,<br /><em>Malang.</em></h2><p>{store.address}, Jawa Timur 65119</p><a href={store.maps} class="button" target="_blank" rel="noreferrer">Buka Google Maps <Icon name="arrow" /></a><div class="hours visit-hours"><p>Bakery <span>07.00 – 22.00</span></p><p>Eatery <span>07.00 – 20.00</span></p><span>Senin – Minggu · Waktu Indonesia Barat</span></div><p class="small-copy">Jam layanan dan hari libur dapat berubah. Waktu pengambilan pesanan mengikuti konfirmasi tim Luke.</p><a class="text-link" href={`https://wa.me/${store.whatsapp}`} target="_blank" rel="noreferrer">Hubungi Luke · {store.phone} ↗</a></div></section>
  <section class="wrap visit-extras"><div><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2>Rencanakan <em>kunjungan Anda.</em></h2><p>Lihat seluruh menu bakery dan eatery, atau hubungi Luke untuk pertanyaan reservasi.</p><div class="contact-actions"><a class="text-link" href={store.fullMenuUrl} target="_blank" rel="noopener noreferrer">Seluruh menu resmi ↗</a><a class="text-link" href={`https://wa.me/${store.whatsapp}`} target="_blank" rel="noopener noreferrer">Pesanan & reservasi ↗</a></div></div><div><p class="eyebrow">LUKE ON YOUR FAVORITE APPS</p><h3>Pilihan platform</h3><p>Temukan Luke melalui GoFood atau GrabFood. Pilihan layanan mengikuti masing-masing aplikasi; pesanan melalui website ini khusus ambil di bakery.</p><div class="contact-actions"><a class="text-link" href={store.gofood} target="_blank" rel="noopener noreferrer">GoFood ↗</a><a class="text-link" href={store.grabfood} target="_blank" rel="noopener noreferrer">GrabFood ↗</a></div><a href="/hubungi/" class="text-link">Kontak & kerja sama →</a></div></section>
</Base>
