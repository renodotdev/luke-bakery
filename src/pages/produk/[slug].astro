---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import PickupFields from '../../components/PickupFields.astro';
import MessagePreview from '../../components/MessagePreview.astro';
import { products, categories, store } from '../../data/catalog';
import { money, whatsappUrl } from '../../lib/order';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.id }, props: { product } })); }
const { product } = Astro.props;
const prices = product.variants.map(v => v.price).filter((n): n is number => n !== null);
const related = products.filter(p => p.category === product.category && p.id !== product.id).slice(0, 3);
const photos = product.image ? [{ src: product.image, alt: product.alt, label: product.name, cutout: product.imageCutout }, ...(product.gallery ?? [])] : [];
---
<Base title={`${product.name} — Luke Artisan Bakery`} description={product.description} image={product.image || undefined} product={product}>
  <nav class="wrap breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href={`/katalog/?kategori=${product.category}`}>{categories.find(c => c.id === product.category)?.name}</a><span>/</span><span aria-current="page">{product.name}</span></nav>
  <section class="wrap product-detail">
    <div class="detail-gallery"><div class:list={['detail-photo', { 'cutout-photo': product.imageCutout }]} data-main-photo>{product.image ? <img src={product.image} alt={product.alt} width="640" height="800" /> : <div class="gift-art"><img src="/images/luke-monogram.jpg" alt="" width="150" height="150" /><span>{product.name}</span></div>}</div>{photos.length > 1 && <><div class="gallery-thumbs" role="group" aria-label="Foto produk">{photos.map((photo, index) => <button type="button" data-photo-src={photo.src} data-photo-alt={photo.alt} data-photo-label={photo.label} data-photo-cutout={String(Boolean(photo.cutout))} aria-pressed={index === 0} aria-label={`Lihat foto ${photo.label}`}><img src={photo.src} alt="" width="64" height="80" /></button>)}</div><p class="gallery-caption" data-photo-caption>{photos[0].label}</p></>}</div>
    <div class="detail-copy"><p class="eyebrow">{categories.find(c => c.id === product.category)?.name}</p><h1>{product.name}</h1><p class="detail-description">{product.description}</p>
      <div class="detail-price" data-product-price>{prices.length ? `${new Set(prices).size > 1 ? 'Mulai dari ' : ''}${money(Math.min(...prices))}` : 'Penawaran sesuai kebutuhan Anda'}</div>
      {product.kind === 'fixed' ? <>
        <form data-add-form data-product={product.id} data-requires-js hidden>
          <label class="field">{product.variants.length > 1 ? 'Pilih ukuran / varian' : 'Pilihan'}<select name="variant" required data-variant-select aria-label={product.variants.length > 1 ? 'Pilih ukuran / varian' : 'Pilihan'}>
            {product.variants.length > 1 && <option value="" selected disabled>Pilih varian terlebih dahulu</option>}
            {product.variants.map(v => <option value={v.id}>{v.name} — {money(v.price!)}</option>)}
          </select></label>
          <div class="add-row"><label class="field quantity-field">Jumlah<input name="quantity" type="number" min="1" max="99" step="1" value="1" required inputmode="numeric" /></label><button class="button" type="submit" disabled={product.availability === 'unavailable'}>Tambah ke keranjang <Icon name="plus" /></button></div>
        </form>
        <p class="small-copy">Harga belum termasuk pajak 10%. Estimasi termasuk pajak terlihat di keranjang. Ketersediaan dan total akhir mengikuti konfirmasi tim Luke.</p>
        <p class="product-status">{product.availability === 'unavailable' ? 'Sementara tidak tersedia' : `Pre-order minimal ${product.leadHours} jam · ambil di bakery`}</p>
      </> : <div class="inquiry-panel"><form data-inquiry-form data-product={product.id} data-requires-js hidden><PickupFields inquiry /><button type="submit" class="button button-full">Diskusikan pesanan <Icon name="arrow" /></button></form><MessagePreview /></div>}
      {product.details && <ul class="product-notes">{product.details.map(detail => <li>{detail}</li>)}</ul>}
      <div class="detail-facts"><div><Icon name="bag" /><div><strong>Ambil langsung di bakery</strong><p>Waktu pengambilan dikonfirmasi oleh tim Luke.</p></div></div><div><Icon name="pin" /><div><strong>Pahlawan Trip No.11, Malang</strong><p><a class="text-link" href="/kunjungi/">Lokasi & jam buka ↗</a></p></div></div></div>
      <details class="product-faq"><summary>Komposisi, alergen & penyimpanan</summary><p>Hubungi tim Luke untuk informasi komposisi, alergen, dan penyimpanan yang sesuai dengan varian Anda. Sampaikan kebutuhan diet atau alergi sebelum memesan.</p><a class="text-link" href={whatsappUrl(store.whatsapp, `Halo Luke, saya ingin menanyakan informasi komposisi, alergen, dan penyimpanan ${product.name}.`)} target="_blank" rel="noopener noreferrer">Tanyakan kepada Luke ↗</a></details>
      <p class="source-link"><a href={store.menuUrl} target="_blank" rel="noopener noreferrer">Lihat katalog resmi ↗</a> · Harga dan ketersediaan dapat berubah.</p>
      <noscript><p class="quiet-note">Aktifkan JavaScript untuk menggunakan keranjang, atau <a href={whatsappUrl(store.whatsapp)} target="_blank" rel="noreferrer">hubungi Luke langsung melalui WhatsApp</a>.</p></noscript>
    </div>
  </section>
  {related.length > 0 && <section class="section wrap related-section"><div class="section-heading"><div><p class="eyebrow">A LITTLE MORE TO LOVE</p><h2>Temukan pilihan <em>lainnya.</em></h2></div></div><div class="menu-list">{related.map(p => <ProductCard product={p} compact />)}</div></section>}
</Base>
